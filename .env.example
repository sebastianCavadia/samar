# Copiar a .env y completar antes de desplegar. No subir .env al repositorio.
SAMAR_DOMINIO=samar.duckdns.org

# Seguridad: usar valores aleatorios y largos. El JWT_SECRET debe tener 32 bytes o más.
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-32-bytes-o-mas
ADMIN_CORREO=admin@samar.co
ADMIN_PASSWORD=cambia-esta-clave-de-administrador

# Postgres: solo accesible dentro de la red de Docker.
# Estas contraseñas se aplican únicamente cuando el volumen se crea por primera vez.
POSTGRES_PASSWORD=cambia-esta-clave-de-postgres
CUENTAS_DB_PASSWORD=cambia-esta-clave-de-cuentas
OFERTA_DB_PASSWORD=cambia-esta-clave-de-oferta
RESERVAS_DB_PASSWORD=cambia-esta-clave-de-reservas
RECOMENDACIONES_DB_PASSWORD=cambia-esta-clave-de-recomendaciones

# Tareas automáticas: valores cómodos para la demo.
# Para probar la expiración rápido: EXPIRACION_SIN_PAGO_MIN=1 y reiniciar reservas-service.
EXPIRACION_SIN_PAGO_MIN=1440
TAREA_MS=5000
SINCRONIZACION_MS=5000

# Opcional: límite de memoria de cada JVM.
# JAVA_TOOL_OPTIONS=-Xmx256m
